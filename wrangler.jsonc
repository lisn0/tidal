{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tidal",
  "main": "_site/worker.js",
  "compatibility_date": "2026-05-05",
  "observability": {
    "enabled": true
  },
  // AI crawler hits (GEO analytics). Free tier: 10M writes/mo, 90-day retention.
  // Separate dataset from finops-llm so the two brands report independently.
  "analytics_engine_datasets": [
    {
      "binding": "AI_HITS",
      "dataset": "llmcfo_ai_crawler_hits"
    }
  ],
  // Contact API: 5 attempts per minute per connecting IP at each Cloudflare location.
  "ratelimits": [
    { "name": "CONTACT_RATE_LIMIT", "namespace_id": "9274102", "simple": { "limit": 5, "period": 60 } }
  ],
  // Activate only after onboarding llmcfo.com to Email Service and verifying
  // hello@llmcfo.com as a destination. The Worker fails closed if send fails.
  "send_email": [
    { "name": "EMAIL", "destination_address": "hello@llmcfo.com", "allowed_sender_addresses": ["noreply@llmcfo.com"] }
  ],
  "build": {
    "command": "npm run build",
    "cwd": ".",
    "watch_dir": "src"
  },
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
