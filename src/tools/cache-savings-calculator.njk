<script>
const PROVIDERS = [
  { name: "OpenAI", inputPrice: 2.50, cacheReadPrice: 1.25, cacheWritePrice: 2.50, color: "#00A67E" },
  { name: "Anthropic", inputPrice: 3.00, cacheReadPrice: 0.30, cacheWritePrice: 3.75, color: "#D97757" },
  { name: "Google", inputPrice: 1.25, cacheReadPrice: 0.31, cacheWritePrice: 1.25, color: "#4285F4" },
];

function calculate() {
  const systemTokens = parseInt(document.getElementById('systemPromptTokens').value) || 0;
  const userTokens = parseInt(document.getElementById('userTokens').value) || 0;
  const requestsPerDay = parseInt(document.getElementById('requestsPerDay').value) || 0;
  const hitRate = parseInt(document.getElementById('cacheHitRate').value) || 0;
  
  const totalInput = systemTokens + userTokens;
  const hits = Math.round(requestsPerDay * (hitRate / 100));
  const misses = requestsPerDay - hits;
  
  const results = PROVIDERS.map(p => {
    // Without caching
    const dailyWithoutCache = requestsPerDay * (totalInput * p.inputPrice / 1000000);
    
    // With caching
    const cacheWriteTokens = misses * totalInput + hits * systemTokens;
    const cacheReadTokens = hits * systemTokens;
    const dailyWithCache = (cacheWriteTokens * p.cacheWritePrice / 1000000) + 
                           (cacheReadTokens * p.cacheReadPrice / 1000000) +
                           (requestsPerDay * userTokens * p.inputPrice / 1000000);
    
    const dailySavings = dailyWithoutCache - dailyWithCache;
    const monthlySavings = dailySavings * 30;
    const savingsPct = (dailySavings / dailyWithoutCache) * 100;
    
    return {
      ...p,
      dailyWithoutCache,
      dailyWithCache,
      dailySavings,
      monthlySavings,
      savingsPct,
      worthwhile: monthlySavings > 10 && savingsPct > 5
    };
  });
  
  // Render cards
  const grid = document.getElementById('resultsGrid');
  grid.innerHTML = results.map(r => `
    <div class="result-card">
      <h3 style="color:${r.color}">${r.name}</h3>
      <div class="metric"><span>Without cache</span><strong>$${r.dailyWithoutCache.toFixed(2)}/day</strong></div>
      <div class="metric"><span>With cache</span><strong>$${r.dailyWithCache.toFixed(2)}/day</strong></div>
      <div class="metric"><span>Daily savings</span><strong class="${r.dailySavings > 0 ? 'savings' : 'warning'}">$${r.dailySavings.toFixed(2)}</strong></div>
      <div class="metric"><span>Monthly savings</span><strong class="${r.monthlySavings > 0 ? 'savings' : 'warning'}">$${r.monthlySavings.toFixed(0)}</strong></div>
      <div class="metric"><span>Savings %</span><strong class="${r.savingsPct > 0 ? 'savings' : 'warning'}">${r.savingsPct.toFixed(1)}%</strong></div>
    </div>
  `).join('');
  
  // Render verdict
  const best = results.reduce((a, b) => a.monthlySavings > b.monthlySavings ? a : b);
  const verdict = document.getElementById('verdict');
  
  if (best.worthwhile) {
    verdict.innerHTML = `
      <span class="go">✓ Enable caching.</span><br><br>
      <strong>${best.name}</strong> offers the best savings: <strong>$${best.monthlySavings.toFixed(0)}/month</strong> (${best.savingsPct.toFixed(1)}% reduction).<br><br>
      Your ${hitRate}% hit rate and ${systemTokens.toLocaleString()}-token system prompt make caching worthwhile. 
      ${best.name === 'Anthropic' ? 'Note: Anthropic charges a 25% premium on cache writes, so your hit rate needs to stay above 55% to break even.' : ''}
    `;
  } else {
    verdict.innerHTML = `
      <span class="no-go">✗ Skip caching for now.</span><br><br>
      Savings are too small to justify complexity. Best case: <strong>$${best.monthlySavings.toFixed(0)}/month</strong> on ${best.name}.<br><br>
      To make caching worthwhile, increase your hit rate above 70% or your system prompt above 2,000 tokens. 
      ${hitRate < 50 ? 'Your low hit rate is the main blocker — prompts need to share prefixes within the TTL window.' : ''}
    `;
  }
}

document.querySelectorAll('input').forEach(input => {
  input.addEventListener('input', calculate);
});

calculate();
</script>

