<script>
// Progressive enhancement only. Both tables are already in the HTML above, so
// this never has to build them: it filters rows already on the page, keeps the
// retirement countdown honest between snapshot builds, and appends anything the
// live feed knows that the snapshot predates. A failed fetch changes nothing.
(function () {
  var fmt = function (v) {
    if (v === null || v === undefined) return '—';
    return '$' + v;
  };
  var ctx = function (n) {
    if (!n) return '—';
    return n >= 1e6 ? +(n / 1e6).toFixed(2) + 'M' : Math.round(n / 1000) + 'K';
  };

  function filterTo(lab) {
    document.querySelectorAll('.chip').forEach(function (c) {
      var on = c.dataset.lab === lab;
      c.classList.toggle('is-on', on);
      c.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    [['shippedTable', 'shippedEmpty'], ['retiringTable', 'retiringEmpty']].forEach(function (pair) {
      var shown = 0;
      document.querySelectorAll('#' + pair[0] + ' tbody tr').forEach(function (row) {
        var on = lab === 'all' || row.dataset.lab === lab;
        row.hidden = !on;
        if (on) shown++;
      });
      document.getElementById(pair[1]).hidden = shown !== 0;
    });
  }

  document.querySelectorAll('.chip').forEach(function (chip) {
    chip.addEventListener('click', function () { filterTo(chip.dataset.lab); });
  });
  filterTo('all');

  // Recount the countdown: a snapshot is dated, a reader is not.
  var tick = function () {
    var today = new Date().toISOString().slice(0, 10);
    document.querySelectorAll('#retiringTable tbody tr').forEach(function (row) {
      var cell = row.querySelector('[data-days]');
      if (!cell || !row.dataset.expires) return;
      var days = Math.round((Date.parse(row.dataset.expires + 'T00:00:00Z') - Date.parse(today + 'T00:00:00Z')) / 864e5);
      cell.textContent = days + 'd';
      row.classList.toggle('is-urgent', days <= 30);
    });
  };
  tick();

  fetch('/api/releases')
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (d) {
      if (!d || !Array.isArray(d.releases)) return;
      var known = {};
      document.querySelectorAll('#shippedTable tbody tr').forEach(function (row) { known[row.dataset.id] = true; });
      var tbody = document.querySelector('#shippedTable tbody');
      var added = 0;

      d.releases.forEach(function (r) {
        if (known[r.id]) return;
        var tr = document.createElement('tr');
        tr.dataset.lab = r.provider;
        tr.dataset.id = r.id;
        tr.className = 'is-live';
        tr.innerHTML =
          '<td>' + r.date + '</td><td><strong>' + r.id + '</strong></td><td>' + r.provider +
          '</td><td class="num">' + fmt(r.in) + '</td><td class="num">' + fmt(r.out) +
          '</td><td class="num">' + ctx(r.ctx) + '</td>';
        tbody.insertBefore(tr, tbody.firstChild);
        added++;
      });

      document.getElementById('liveCheck').textContent =
        'Live feed checked ' + (d.updated || '') + (added ? ' · ' + added + ' new since the snapshot' : ' · up to date');
    })
    .catch(function () {});
})();
</script>

