<script>
const CACHE_READ_FACTOR = 0.10;
const M = 1000000;

function num(id, fallback) {
  const v = parseFloat(document.getElementById(id).value);
  return isNaN(v) ? fallback : v;
}

function spendFor(inRate, outRate, req, inTok, outTok, hitRate) {
  const billedIn = inTok * (1 - (hitRate / 100) * (1 - CACHE_READ_FACTOR));
  return req * ((billedIn * inRate) / M + (outTok * outRate) / M);
}

function calculate() {
  const req = num('requestsPerMonth', 0);
  const inTok = num('inTokens', 0);
  const outTok = num('outTokens', 0);
  const hitRate = num('cacheHitRate', 0);

  const aIn = num('tierAIn', 0), aOut = num('tierAOut', 0);
  const bIn = num('tierBIn', 0), bOut = num('tierBOut', 0);

  let aShare = Math.max(0, num('tierAShare', 0));
  let bShare = Math.max(0, num('tierBShare', 0));
  const shareTotal = aShare + bShare;
  if (shareTotal === 0) aShare = bShare = 0;
  else { aShare = (aShare / shareTotal) * 100; bShare = (bShare / shareTotal) * 100; }

  const uncertain = Math.min(100, Math.max(0, num('aliasUncertain', 0)));
  const outcomes = Math.max(1, num('outcomesPerMonth', 1));
  const value = num('valuePerOutcome', 0);

  const blendedIn = (aShare / 100) * aIn + (bShare / 100) * bIn;
  const blendedOut = (aShare / 100) * aOut + (bShare / 100) * bOut;

  const spend = spendFor(blendedIn, blendedOut, req, inTok, outTok, hitRate);

  // Unverified traffic could resolve entirely to the cheap tier or entirely to the premium one.
  const known = 1 - uncertain / 100;
  const lowIn = (known * aShare) / 100 * aIn + ((1 - known) + (bShare / 100)) * bIn;
  const lowOut = (known * aShare) / 100 * aOut + ((1 - known) + (bShare / 100)) * bOut;
  const highIn = (known * bShare) / 100 * bIn + ((1 - known) + (aShare / 100)) * aIn;
  const highOut = (known * bShare) / 100 * bOut + ((1 - known) + (aShare / 100)) * aOut;

  const low = spendFor(Math.min(lowIn, highIn), Math.min(lowOut, highOut), req, inTok, outTok, hitRate);
  const high = spendFor(Math.max(lowIn, highIn), Math.max(lowOut, highOut), req, inTok, outTok, hitRate);

  const costPerOutcome = spend / outcomes;
  const margin = value - costPerOutcome;
  const marginPct = value > 0 ? (margin / value) * 100 : 0;
  const bandPct = spend > 0 ? ((high - low) / spend) * 100 : 0;

  const grid = document.getElementById('resultsGrid');
  grid.innerHTML = `
    <div class="result-card">
      <h3>Blended rate</h3>
      <div class="metric"><span>Input</span><strong>$${blendedIn.toFixed(2)}/1M</strong></div>
      <div class="metric"><span>Output</span><strong>$${blendedOut.toFixed(2)}/1M</strong></div>
      <div class="metric"><span>Mix</span><strong>${aShare.toFixed(0)}% premium / ${bShare.toFixed(0)}% mid</strong></div>
    </div>
    <div class="result-card">
      <h3>Monthly spend</h3>
      <div class="metric"><span>Total</span><strong>$${spend.toFixed(0)}</strong></div>
      <div class="metric"><span>Per request</span><strong>$${(req > 0 ? spend / req : 0).toFixed(4)}</strong></div>
      <div class="metric"><span>Unverified band</span><strong class="${bandPct > 10 ? 'warning' : 'savings'}">$${low.toFixed(0)} to $${high.toFixed(0)}</strong></div>
    </div>
    <div class="result-card">
      <h3>Per outcome</h3>
      <div class="metric"><span>Cost</span><strong>$${costPerOutcome.toFixed(2)}</strong></div>
      <div class="metric"><span>Margin</span><strong class="${margin >= 0 ? 'savings' : 'warning'}">$${margin.toFixed(2)}</strong></div>
      <div class="metric"><span>Margin %</span><strong class="${margin >= 0 ? 'savings' : 'warning'}">${marginPct.toFixed(1)}%</strong></div>
    </div>
  `;

  const verdict = document.getElementById('verdict');
  const healthy = margin > 0 && marginPct > 60;

  const lines = [];
  if (bandPct > 10) {
    lines.push(`<span class="no-go">Your forecast is not one number.</span> With ${uncertain.toFixed(0)}% of traffic on unverified aliases, real spend could be anywhere in a ${bandPct.toFixed(0)}% band around <strong>$${spend.toFixed(0)}</strong>. Resolve which model serves those requests before you commit to a budget line.`);
  } else {
    lines.push(`<span class="go">Your forecast band is narrow.</span> Unverified aliases only move the number by ${bandPct.toFixed(0)}%, so <strong>$${spend.toFixed(0)}</strong> is defensible in a budget.`);
  }

  if (healthy) {
    lines.push(`At <strong>$${costPerOutcome.toFixed(2)}</strong> per outcome against $${value.toFixed(2)} of value, this holds a ${marginPct.toFixed(0)}% margin. That is the number to put in front of a budget owner, not the token rate.`);
  } else if (margin >= 0) {
    lines.push(`At <strong>$${costPerOutcome.toFixed(2)}</strong> per outcome you are only keeping ${marginPct.toFixed(0)}% of the value. That is survivable, but it will not survive a bad quarter without a routing change.`);
  } else {
    lines.push(`<span class="no-go">This loses money as modelled.</span> <strong>$${costPerOutcome.toFixed(2)}</strong> per outcome against $${value.toFixed(2)} of value. Either the denominator is too generous, the value per outcome is too low, or the mix needs to move down a tier.`);
  }

  lines.push(`<strong>Definition:</strong> cost per outcome = $${spend.toFixed(0)} monthly AI spend ÷ ${outcomes.toLocaleString()} resolved outcomes. If your denominator counts something else, this number is not comparable to anyone else's.`);
  verdict.innerHTML = lines.join('<br><br>');
}

document.querySelectorAll('input').forEach(input => {
  input.addEventListener('input', calculate);
});

calculate();
</script>

