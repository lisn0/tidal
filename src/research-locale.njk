---json
{
  "pagination": { "data": "localeHubs", "size": 1, "alias": "hub" },
  "permalink": "{{ hub.permalink }}"
}
---
{%- set lang = hub.lang -%}
{%- set ui = articleUi[lang] -%}
{%- set siteUrl = 'https://llmcfo.com' -%}
{%- set canonicalUrl = siteUrl + '/' + lang + '/research' -%}
<!DOCTYPE html>
<html lang="{{ lang }}"{% if lang == 'ar' %} dir="rtl"{% endif %}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ ui.hubTitle }} &middot; LLM CFO</title>
<meta name="description" content="{{ ui.hubDescription }}" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href="{{ canonicalUrl }}" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="LLM CFO" />
<meta property="og:locale" content="{{ lang }}" />
<meta property="og:url" content="{{ canonicalUrl }}" />
<meta property="og:title" content="{{ ui.hubTitle }}" />
<meta property="og:description" content="{{ ui.hubDescription }}" />
<meta property="og:image" content="{{ siteUrl }}/og.png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ ui.hubTitle }}" />
<meta name="twitter:description" content="{{ ui.hubDescription }}" />
<meta name="twitter:image" content="{{ siteUrl }}/og.png" />
<link rel="alternate" hreflang="en" href="{{ siteUrl }}/research" />
{%- for code in hub.locales -%}
<link rel="alternate" hreflang="{{ code }}" href="{{ siteUrl }}/{{ code }}/research" />
{%- endfor -%}
<link rel="alternate" hreflang="x-default" href="{{ siteUrl }}/research" />
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"CollectionPage","name":{{ ui.hubH1 | dump | safe }},"description":{{ ui.hubDescription | dump | safe }},"url":"{{ canonicalUrl }}","inLanguage":"{{ lang }}","dateModified":"{{ hub.dateModified }}","publisher":{"@type":"Organization","name":"LLM CFO","url":"https://llmcfo.com/"}}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":{{ ui.home | dump | safe }},"item":"https://llmcfo.com/"},{"@type":"ListItem","position":2,"name":{{ ui.research | dump | safe }},"item":"{{ canonicalUrl }}"}]}
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#FBFAF6" />
<link rel="preload" href="/assets/fonts/geist-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/assets/page.css" />
{%- if lang == 'ar' -%}
<style>
.topbar .nav, .back { direction: ltr; }
.langsw { direction: ltr; }
</style>
{%- endif -%}
<script src="/assets/consent.js" defer></script><script src="/assets/attribution.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">{{ ui.skip }}</a>
<header class="topbar"><div class="inner">
  <a class="site-brand" href="/" aria-label="LLM CFO {{ ui.home }}"><span class="mark" aria-hidden="true">$</span><span class="brand">LLM CFO</span></a>
  <nav class="site-nav" aria-label="{{ ui.navigation }}">
    <a href="/">{{ ui.home }}</a><a href="/{{ lang }}/research" aria-current="page">{{ ui.research }}</a><a href="/benchmarks">{{ ui.benchmarks }}</a><a href="/about">{{ ui.about }}</a><a class="nav-cta" href="/book">{{ ui.auditButton }} <span aria-hidden="true">→</span></a>
  </nav>
</div></header>

<main class="wrap" id="main" tabindex="-1">
<nav class="breadcrumbs" aria-label="{{ ui.article }}"><a href="/">{{ ui.home }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ ui.research }}</span></nav>

<nav class="langsw" aria-label="{{ ui.language }}" style="font-family:ui-monospace,monospace;font-size:13px;margin-bottom:20px">
<a href="/research" hreflang="en">EN</a>
{%- for code in hub.locales %} · {% if code == lang -%}
<a href="/{{ code }}/research" hreflang="{{ code }}" aria-current="page" style="font-weight:600">{{ code | upper }}</a>
{%- else -%}
<a href="/{{ code }}/research" hreflang="{{ code }}">{{ code | upper }}</a>
{%- endif -%}
{%- endfor %}
</nav>

<h1 class="page-title">{{ ui.hubH1 }}</h1>
<p class="lede">{{ ui.hubIntro }}</p>

<ul>
{%- for a in hub.articles %}
  <li><a href="{{ a.url }}">{{ a.title | safe }}</a></li>
{%- endfor %}
</ul>

<a class="back" href="/">← {{ ui.back }}</a>

<aside class="callout"><strong>{{ ui.bottomLead }}</strong> {{ ui.bottomBody }} <a href="/book">{{ ui.auditButton }} &rarr;</a></aside>
</main>

<footer class="pagefoot">
  <span>// © 2026 LLM CFO, Inc.</span>
  <span><a href="/privacy">{{ ui.privacy }}</a> · <a href="/terms">{{ ui.terms }}</a> · <a href="/security">{{ ui.security }}</a></span>
</footer>
</body>
</html>
