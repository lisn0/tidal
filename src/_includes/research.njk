<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ titleCore | safe }} &middot; LLM CFO</title>
<meta name="description" content="{{ description | safe }}" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href="https://llmcfo.com/research/{{ slug }}" />
{# The schema says the same thing as <title>/<meta description>, so it reads the
    same fields. It used to read separate schemaHeadline/schemaDescription copies,
    and 10 headlines plus 30 descriptions had drifted away from the page. -#}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"TechArticle","headline":{{ titleCore | dump | safe }},"description":{{ description | dump | safe }},"url":"https://llmcfo.com/research/{{ slug }}","datePublished":"{{ datePublished }}","dateModified":"{{ dateModified }}","image":"https://llmcfo.com/og.png","author":{"@type":"Organization","name":"LLM CFO team"},"publisher":{"@type":"Organization","name":"LLM CFO","url":"https://llmcfo.com/"}}
</script>
{#- Built from the same `faq` entries the page renders below. It used to be a
    hand-written JSON-LD blob per page, which is 54 copies of a shape nothing
    checked and no way to keep the schema and the page saying the same thing. -#}
{%- if faq and faq.length %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in faq %}{% if not loop.first %},{% endif %}{"@type":"Question","name":{{ f.q | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | dump | safe }}}}{% endfor %}]}
</script>
{%- endif %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://llmcfo.com/"},{"@type":"ListItem","position":2,"name":"Research","item":"https://llmcfo.com/research"},{"@type":"ListItem","position":3,"name":"{{ breadcrumbName | safe }}","item":"https://llmcfo.com/research/{{ slug }}"}]}
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#FBFAF6" />
<link rel="preload" href="/assets/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/assets/page.css" />
<script src="/assets/consent.js" defer></script><script src="/assets/attribution.js" defer></script>
</head>
<body>
<div class="topbar"><div class="inner"><div class="left"><span class="mark" aria-hidden="true">$</span><a class="brand" href="/">LLM CFO</a></div><a class="nav" href="/">&larr; home</a></div></div>

<main class="wrap">
<aside class="callout"><strong>Auditing your own LLM spend?</strong> LLM CFO runs a free audit of your AI costs and shows which workloads are driving the bill. <a href="/book">Book a free audit &rarr;</a></aside>
{{ content | updateVisibleDate(dateModified, datePublished) | safe }}
{%- if faq and faq.length %}
<section class="faq" aria-labelledby="faq-heading">
<h2 id="faq-heading">FAQ</h2>
{%- for f in faq %}
<h3>{{ f.q }}</h3>
<p>{{ f.a }}</p>
{%- endfor %}
</section>
{%- endif %}
<aside class="callout"><strong>Want this applied to your stack?</strong> Bring the provider bills, gateway logs, and top workflows; we will map the cost drivers and savings path. <a href="/book">Book a free audit &rarr;</a></aside>
</main>

<footer class="pagefoot">
  <span>// {{ copyrightSymbol | safe }} 2026 LLM CFO, Inc.</span>
  <span><a href="/privacy">Privacy</a> {{ footerSeparator | safe }} <a href="/terms">Terms</a> {{ footerSeparator | safe }} <a href="/security">Security</a></span>
</footer>
</body>
</html>
