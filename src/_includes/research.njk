{%- if faqJsonLd %}
<script type="application/ld+json">
{{ faqJsonLd | safe }}
</script>
{%- endif %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://llmcfo.com/"},{"@type":"ListItem","position":2,"name":"Research","item":"https://llmcfo.com/research"},{"@type":"ListItem","position":3,"name":"{{ breadcrumbName | safe }}","item":"https://llmcfo.com/research/{{ slug }}"}]}
