{%- set article = articles[slug] -%}
{%- if not article -%}
  {{ throw("Missing article data for slug: " + slug) }}
{%- endif -%}
{%- set lang = lang or 'en' -%}
{%- set locale = article.languages[lang] -%}
{%- if not locale -%}
  {{ throw("Missing language " + lang + " for article: " + slug) }}
{%- endif -%}
{%- set ui = articleUi[lang] or articleUi.en -%}
{%- set siteUrl = 'https://llmcfo.com' -%}
{#- A "-v2" article is an A/B variant that canonicals to its control — but only
    the English control is actually published. Stripping "-v2" for a translated
    variant pointed the canonical and hreflangs at a 404, which de-indexes the
    page entirely. Non-English variants stay self-canonical. -#}
{%- set enSlug = article.slug -%}
{%- if enSlug.slice(-3) == '-v2' -%}{%- set enSlug = enSlug.slice(0, -3) -%}{%- endif -%}
{%- set canonicalPath = ('/' + lang + '/research/' + article.slug) if lang != 'en' else ('/research/' + enSlug) -%}
{%- set canonicalUrl = siteUrl + canonicalPath -%}

{%- set hreflangs = [] -%}
{%- for code in article.languages | keys -%}
  {%- if code == 'en' -%}
    {%- set _ = hreflangs.push({ lang: code, href: siteUrl + '/research/' + enSlug }) -%}
  {%- else -%}
    {%- set _ = hreflangs.push({ lang: code, href: siteUrl + '/' + code + '/research/' + article.slug }) -%}
  {%- endif -%}
{%- endfor -%}
{%- set _ = hreflangs.push({ lang: 'x-default', href: siteUrl + '/research/' + enSlug }) -%}

{%- set faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": []
} -%}

<!DOCTYPE html>
<html lang="{{ lang }}"{% if lang == 'ar' %} dir="rtl"{% endif %}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{{ locale.titleCore | safe }} &middot; LLM CFO</title>
<meta name="description" content="{{ locale.description }}" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
{%- if article.agentMode -%}
<meta name="content-signal" content="search=yes, ai-input=yes, ai-train=yes" />
{%- endif -%}
<link rel="canonical" href="{{ canonicalUrl }}" />
<meta property="og:type" content="article" />
<meta property="og:site_name" content="LLM CFO" />
<meta property="og:locale" content="{{ lang }}" />
<meta property="og:url" content="{{ canonicalUrl }}" />
<meta property="og:title" content="{{ locale.titleCore or locale.title }}" />
<meta property="og:description" content="{{ locale.description }}" />
<meta property="og:image" content="{{ article.image or (siteUrl + '/og.png') }}" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="LLM CFO" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ locale.titleCore or locale.title }}" />
<meta name="twitter:description" content="{{ locale.description }}" />
<meta name="twitter:image" content="{{ article.image or (siteUrl + '/og.png') }}" />
{%- for alt in hreflangs -%}
<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.href }}" />
{%- endfor -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"TechArticle","headline":{{ (locale.titleCore or locale.title) | dump | safe }},"description":"{{ locale.description | safe }}","url":"{{ canonicalUrl }}","datePublished":"{{ article.datePublished }}","dateModified":"{{ article.dateModified }}","image":"{{ article.image }}","author":{"@type":"Organization","name":"LLM CFO team"},"publisher":{"@type":"Organization","name":"LLM CFO","url":"https://llmcfo.com/"}}
</script>
{%- if locale.faq.length > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for q in locale.faq -%}
    {
      "@type": "Question",
      "name": {{ q.question | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ q.answer | dump | safe }}
      }
    }{%- if not loop.last -%},{%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":{{ ui.home | dump | safe }},"item":"https://llmcfo.com/"},{"@type":"ListItem","position":2,"name":{{ ui.research | dump | safe }},"item":"https://llmcfo.com/research"},{"@type":"ListItem","position":3,"name":{{ locale.titleCore | dump | safe }},"item":"{{ canonicalUrl }}"}]}
</script>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<meta name="theme-color" content="#FBFAF6" />
<link rel="preload" href="/assets/fonts/geist-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/assets/page.css" />
{%- if lang == 'ar' -%}
<style>
code, pre { direction: ltr; text-align: left; unicode-bidi: embed; }
.topbar .nav, .back { direction: ltr; }
table.kv th, table.kv td { text-align: right; }
table.kv th:last-child, table.kv td:last-child { text-align: left; }
.langsw { direction: ltr; }
</style>
{%- endif -%}
{%- if article.agentMode -%}
<script type="text/x-llms-txt">
# {{ locale.title }}
> {{ locale.description }}
- URL: {{ canonicalUrl }}
- Content-Signal: search=yes, ai-input=yes, ai-train=yes
{%- for q in locale.faq %}
Q: {{ q.question }}
A: {{ q.answer }}
{%- endfor %}
</script>
{%- endif -%}
<script src="/assets/consent.js" defer></script><script src="/assets/attribution.js" defer></script>
</head>
<body>
<a class="skip-link" href="#main">{{ ui.skip }}</a>
<header class="topbar"><div class="inner">
  <a class="site-brand" href="/" aria-label="LLM CFO {{ ui.home }}"><span class="mark" aria-hidden="true">$</span><span class="brand">LLM CFO</span></a>
  <nav class="site-nav" aria-label="{{ ui.navigation }}">
    <a href="/">{{ ui.home }}</a><a href="/research" hreflang="en">{{ ui.research }}{% if lang != 'en' %} <span lang="en">(EN)</span>{% endif %}</a><a href="/benchmarks">{{ ui.benchmarks }}</a><a href="/about">{{ ui.about }}</a><a class="nav-cta" href="/book">{{ ui.auditButton }} <span aria-hidden="true">→</span></a>
  </nav>
</div></header>

<main class="wrap" id="main" tabindex="-1">
<nav class="breadcrumbs" aria-label="{{ ui.article }}"><a href="/">{{ ui.home }}</a><span aria-hidden="true">/</span><a href="/research" hreflang="en">{{ ui.research }}{% if lang != 'en' %} <span lang="en">(EN)</span>{% endif %}</a><span aria-hidden="true">/</span><span aria-current="page">{{ locale.titleCore | safe }}</span></nav>

<nav class="langsw" aria-label="{{ ui.language }}" style="font-family:ui-monospace,monospace;font-size:13px;margin-bottom:20px">
{%- for code in article.languages | keys -%}
  {%- set prefix = '/' + code if code != 'en' else '' -%}
  {%- set label = code | upper -%}
  {%- if code == lang -%}<a href="{{ prefix }}/research/{{ article.slug }}" hreflang="{{ code }}" aria-current="page" style="font-weight:600">{{ label }}</a>
  {%- else -%}<a href="{{ prefix }}/research/{{ article.slug }}" hreflang="{{ code }}">{{ label }}</a>
  {%- endif -%}
  {%- if not loop.last -%} · {%- endif -%}
{%- endfor -%}
</nav>

<h1 class="page-title">{{ locale.titleCore | safe }}</h1>
<p class="updated">{{ ui.updated }}: {{ article.dateModified | formatDate }}</p>
<p class="byline">{{ ui.byline }}</p>
{%- if article.agentMode -%}
<aside class="callout agent-summary" aria-label="{{ ui.quick }}">
  <strong>{{ ui.quick }}:</strong> {{ locale.body | striptags | truncate(200) }}
</aside>
{%- endif -%}

{{ locale.body | safe }}

{%- if locale.related.length > 0 -%}
<h2>{{ ui.related }}</h2>
<ul>
{%- for link in locale.related -%}
  <li><a href="{{ link.slug }}">{{ link.label }}</a></li>
{%- endfor -%}
</ul>
{%- endif -%}

<a class="back" href="/">← {{ ui.back }}</a>

<aside class="callout"><strong>{{ ui.bottomLead }}</strong> {{ ui.bottomBody }} <a href="/book">{{ ui.auditButton }} &rarr;</a></aside>
</main>

<footer class="pagefoot">
  <span>// {{ article.copyrightSymbol or '©' }} 2026 LLM CFO, Inc.</span>
  <span><a href="/privacy">{{ ui.privacy }}</a> {{ article.footerSeparator or '·' }} <a href="/terms">{{ ui.terms }}</a> {{ article.footerSeparator or '·' }} <a href="/security">{{ ui.security }}</a></span>
</footer>
</body>
</html>
